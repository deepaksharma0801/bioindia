{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bioindia-api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "app.main:app", "--app-dir", "backend", "--host", "127.0.0.1", "--port", "8000"],
      "env": { "DATABASE_URL": "postgresql://bioindia:bioindia@127.0.0.1:5432/bioindia" },
      "port": 8000
    },
    {
      "name": "bioindia-dashboard",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "5500", "--bind", "127.0.0.1"],
      "port": 5500
    },
    {
      "name": "bioindia-static-site",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "http.server", "5600", "--bind", "127.0.0.1", "--directory", "site"],
      "port": 5600
    }
  ]
}
