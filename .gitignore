# Python
__pycache__/
*.pyc
.venv/
.pytest_cache/

# Secrets
.env

# Data: large, regenerable, or licensed (IUCN, WDPA, WorldClim and GBIF terms restrict redistribution).
# Only the GBIF download request is kept, so the download can be reproduced.
/data/*
!/data/raw/
/data/raw/*
!/data/raw/gbif/
/data/raw/gbif/*
!/data/raw/gbif/gbif_download_request*.json
/outputs/

